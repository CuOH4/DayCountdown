<Window x:Class="DayCountdown.CountdownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="倒计时"
        Icon="/icon.ico"
        Width="320" Height="180"
        MinWidth="240" MinHeight="120"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>

        <!-- 图标按钮 -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Foreground" Value="#A8A8C8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#40FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 透明缩放 Thumb -->
        <Style x:Key="ResizeThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="#D8D8EA"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

    </Window.Resources>

    <Grid x:Name="Root" ContextMenuOpening="Root_ContextMenuOpening"
          MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="＋ 新建倒计时" Click="New_Click"/>
                <MenuItem Header="✎ 重命名" Click="Rename_Click"/>
                <MenuItem Header="📅 设置目标日期" Click="PickDate_Click"/>
                <MenuItem Header="↗ 移至右上角" Click="ArrangeTopRight_Click"/>
                <Separator/>
                <MenuItem x:Name="TopmostMenuItem" Header="📌 置于最上层" IsCheckable="True"
                          Checked="TopmostMenuItem_Checked" Unchecked="TopmostMenuItem_Unchecked"/>
                <Separator/>
                <MenuItem Header="⚙ 设置" Click="Settings_Click"/>
                <MenuItem Header="✕ 关闭窗口（保留记录）" Click="CloseHide_Click"/>
                <MenuItem Header="🗑 删除此倒计时" Click="Delete_Click"/>
            </ContextMenu>
        </Grid.ContextMenu>

        <!-- 卡片主体 -->
        <Border x:Name="CardBorder" CornerRadius="14" Background="#F01A1A30" Margin="6">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.5" Color="#000000"/>
            </Border.Effect>
            <Grid Margin="14,4,14,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="18"/>
                </Grid.RowDefinitions>

                <!-- 标题栏：备注 + 功能按钮 -->
                <Grid Grid.Row="0">
                    <TextBlock x:Name="NameText" FontSize="13" FontWeight="SemiBold"
                               Foreground="#A8A8C8" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" FontFamily="Microsoft YaHei UI"
                               MouseLeftButtonDown="NameText_MouseLeftButtonDown"
                               ToolTip="双击标题可重命名"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource IconButton}" Content="＋" ToolTip="新建倒计时"
                                Click="New_Click"/>
                        <Button Style="{StaticResource IconButton}" Content="✎" ToolTip="重命名"
                                Click="Rename_Click"/>
                        <Button x:Name="PinButton" Style="{StaticResource IconButton}" Content="📌"
                                ToolTip="置顶（此窗口始终显示在最上层）" Click="PinToggle_Click"/>
                        <Button Style="{StaticResource IconButton}" Content="↗" ToolTip="移至右上角"
                                Click="ArrangeTopRight_Click"/>
                        <Button Style="{StaticResource IconButton}" Content="⚙" ToolTip="设置"
                                Click="Settings_Click"/>
                        <Button Style="{StaticResource IconButton}" Content="✕"
                                ToolTip="关闭窗口（保留记录，可在设置中重新打开）"
                                Click="CloseHide_Click"/>
                    </StackPanel>
                </Grid>

                <!-- 天数大字（随窗口缩放） -->
                <Viewbox Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                         Stretch="Uniform" Margin="0,2">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock x:Name="DayNumberText" FontFamily="Bahnschrift" FontSize="90"
                                   FontWeight="SemiBold" VerticalAlignment="Center">
                            <TextBlock.Foreground>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#7F6BF0" Offset="0"/>
                                    <GradientStop Color="#00CEC9" Offset="1"/>
                                </LinearGradientBrush>
                            </TextBlock.Foreground>
                        </TextBlock>
                        <TextBlock x:Name="DayUnitText" FontSize="26" Foreground="#A8A8C8"
                                   Margin="8,0,0,14" VerticalAlignment="Bottom"
                                   FontFamily="Microsoft YaHei UI"/>
                    </StackPanel>
                </Viewbox>

                <!-- 底部：目标日期 + 状态 -->
                <Grid Grid.Row="2">
                    <TextBlock x:Name="TargetInfoText" FontSize="11" Foreground="#7E7EA0"
                               VerticalAlignment="Center" FontFamily="Consolas" Cursor="Hand"
                               MouseLeftButtonDown="TargetInfoText_MouseLeftButtonDown"
                               ToolTip="双击可修改目标日期"/>
                    <TextBlock x:Name="StatusText" FontSize="11" Foreground="#8E8EB2"
                               HorizontalAlignment="Right" VerticalAlignment="Center"
                               FontFamily="Microsoft YaHei UI"/>
                </Grid>
            </Grid>
        </Border>

        <!-- 8 方向边缘缩放 -->
        <Thumb Style="{StaticResource ResizeThumb}" Tag="L" DragDelta="ResizeDragDelta"
               HorizontalAlignment="Left" VerticalAlignment="Stretch" Width="6" Cursor="SizeWE"/>
        <Thumb Style="{StaticResource ResizeThumb}" Tag="R" DragDelta="ResizeDragDelta"
               HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="6" Cursor="SizeWE"/>
        <Thumb Style="{StaticResource ResizeThumb}" Tag="T" DragDelta="ResizeDragDelta"
               HorizontalAlignment="Stretch" VerticalAlignment="Top" Height="6" Cursor="SizeNS"/>
        <Thumb Style="{StaticResource ResizeThumb}" Tag="B" DragDelta="ResizeDragDelta"
               HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Height="6" Cursor="SizeNS"/>
        <Thumb Style="{StaticResource ResizeThumb}" Tag="TL" DragDelta="ResizeDragDelta"
               HorizontalAlignment="Left" VerticalAlignment="Top" Width="12" Height="12" Cursor="SizeNWSE"/>
        <Thumb Style="{StaticResource ResizeThumb}" Tag="TR" DragDelta="ResizeDragDelta"
               HorizontalAlignment="Right" VerticalAlignment="Top" Width="12" Height="12" Cursor="SizeNESW"/>
        <Thumb Style="{StaticResource ResizeThumb}" Tag="BL" DragDelta="ResizeDragDelta"
               HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="12" Height="12" Cursor="SizeNESW"/>
        <Thumb Style="{StaticResource ResizeThumb}" Tag="BR" DragDelta="ResizeDragDelta"
               HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="12" Height="12" Cursor="SizeNWSE"/>
    </Grid>
</Window>
