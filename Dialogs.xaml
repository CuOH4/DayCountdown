<Window x:Class="DayCountdown.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑"
        Icon="/icon.ico"
        Width="320" Height="auto"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style TargetType="DatePickerTextBox">
            <Setter Property="Foreground" Value="#E4E4F0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CaretBrush" Value="#E4E4F0"/>
            <Setter Property="SelectionBrush" Value="#6C5CE7"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Border CornerRadius="16" Background="#F0242440">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.55" Color="#000000"/>
            </Border.Effect>
            <Grid Margin="20,18,20,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="CaptionText" Grid.Row="0" FontSize="15" FontWeight="SemiBold"
                           Foreground="#E8E8F5" Margin="0,0,0,14"/>

                <!-- 文本输入（重命名） -->
                <Border Grid.Row="1" CornerRadius="9" Background="#232340" Padding="10,4" Margin="0,0,0,14">
                    <TextBox x:Name="InputTextBox" Background="Transparent" BorderThickness="0"
                             Foreground="#E4E4F0" FontSize="14" FontFamily="Microsoft YaHei UI"
                             VerticalContentAlignment="Center" CaretBrush="#6C5CE7"
                             KeyDown="InputTextBox_KeyDown"/>
                </Border>

                <!-- 日期选择（改期） -->
                <Border x:Name="DatePickerHost" Grid.Row="1" CornerRadius="9" Background="#232340"
                        Padding="10,2" Margin="0,0,0,14" Visibility="Collapsed">
                    <DatePicker x:Name="InputDatePicker" Background="Transparent" BorderThickness="0"
                                Foreground="#E4E4F0" FontFamily="Microsoft YaHei UI" FontSize="13"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                </Border>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" Click="Cancel_Click"
                            Content="取消" Foreground="#A6A6C6" Background="Transparent"
                            BorderThickness="0" FontSize="13" Padding="14,6" Margin="0,0,8,0"
                            Cursor="Hand" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"/>
                    <Button x:Name="OkButton" Click="Ok_Click"
                            Content="确定" Foreground="White" Background="#6C5CE7"
                            BorderThickness="0" FontSize="13" Padding="18,7"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                        CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#7D6EF2"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#5A4BD6"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
