<Window x:Class="DayCountdown.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认"
        Icon="/icon.ico"
        Width="360" SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Margin="14" MouseLeftButtonDown="Grid_MouseLeftButtonDown">
        <Border CornerRadius="16" Background="#F0242440">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.55" Color="#000000"/>
            </Border.Effect>
            <Grid Margin="20,18,20,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 标题行：图标 + 标题 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="⚠️" FontSize="20" FontFamily="Segoe UI Emoji"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="CaptionText" FontSize="15" FontWeight="SemiBold"
                               Foreground="#E8E8F5" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 消息 -->
                <TextBlock x:Name="MessageText" Grid.Row="1" FontSize="13"
                           Foreground="#C4C4DC" TextWrapping="Wrap" LineHeight="21"
                           FontFamily="Microsoft YaHei UI" Margin="0,0,0,18"/>

                <!-- 按钮 -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" Click="Cancel_Click"
                            Content="取消" Foreground="#A6A6C6" Background="Transparent"
                            BorderThickness="0" FontSize="13" Padding="14,6" Margin="0,0,8,0"
                            Cursor="Hand" FontFamily="Microsoft YaHei UI"
                            Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"/>
                    <Button x:Name="OkButton" Click="Ok_Click"
                            Content="确定" Foreground="White" Background="#6C5CE7"
                            BorderThickness="0" FontSize="13" Padding="18,7" Cursor="Hand"
                            FontFamily="Microsoft YaHei UI">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                        CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#7D6EF2"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#5A4BD6"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
