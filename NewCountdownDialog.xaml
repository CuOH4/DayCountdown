<Window x:Class="DayCountdown.NewCountdownDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新建倒计时"
        Icon="/icon.ico"
        Width="340" SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style TargetType="DatePickerTextBox">
            <Setter Property="Foreground" Value="#E4E4F0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CaretBrush" Value="#E4E4F0"/>
            <Setter Property="SelectionBrush" Value="#6C5CE7"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14" MouseLeftButtonDown="Grid_MouseLeftButtonDown">
        <Border CornerRadius="16" Background="#F0242440">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.55" Color="#000000"/>
            </Border.Effect>
            <Grid Margin="20,16,20,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="＋ 新建倒计时" FontSize="16" FontWeight="SemiBold"
                           Foreground="#E8E8F5" Margin="0,0,0,14"/>

                <!-- 备注名 -->
                <TextBlock Grid.Row="1" Text="备注名称" FontSize="12" Foreground="#9E9EBC"
                           Margin="2,0,0,6" FontFamily="Microsoft YaHei UI"/>
                <Border Grid.Row="2" CornerRadius="9" Background="#232340" Padding="10,6" Margin="0,0,0,12">
                    <TextBox x:Name="NameTextBox" Background="Transparent" BorderThickness="0"
                             Foreground="#E4E4F0" FontSize="14" FontFamily="Microsoft YaHei UI"
                             VerticalContentAlignment="Center" CaretBrush="#6C5CE7"
                             KeyDown="NameTextBox_KeyDown" MaxLength="30"/>
                </Border>

                <!-- 目标日期 -->
                <TextBlock Grid.Row="3" Text="目标日期" FontSize="12" Foreground="#9E9EBC"
                           Margin="2,0,0,6" FontFamily="Microsoft YaHei UI"/>
                <Border Grid.Row="4" CornerRadius="9" Background="#232340" Padding="10,2" Margin="0,0,0,14">
                    <DatePicker x:Name="DatePickerControl" Background="Transparent" BorderThickness="0"
                                Foreground="#E4E4F0" FontFamily="Microsoft YaHei UI" FontSize="13"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                </Border>

                <!-- 按钮 -->
                <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" Click="Cancel_Click" Foreground="#A6A6C6"
                            Background="Transparent" BorderThickness="0" FontSize="13"
                            Padding="14,6" Margin="0,0,8,0" Cursor="Hand"
                            FontFamily="Microsoft YaHei UI"
                            Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"/>
                    <Button Content="创建" Click="Ok_Click" Padding="18,7" Cursor="Hand"
                            Foreground="White" Background="#6C5CE7" BorderThickness="0"
                            FontSize="13" FontFamily="Microsoft YaHei UI">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#7D6EF2"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#5A4BD6"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
